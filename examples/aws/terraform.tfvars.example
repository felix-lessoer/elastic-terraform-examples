deployment_mode      = "serverless"
elastic_project_name = "AWS Observe and Protect"
elastic_region       = "aws-eu-west-1"
aws_region           = "eu-west-1"

enable_cspm              = true
enable_cnvm              = true
enable_billing_metrics   = true
enable_detection_rules   = true
enable_elastic_agent     = true

# Required: company policy tags (applied to every taggable AWS resource)
company_tags = {
  CostCenter  = "platform"
  Owner       = "sre-team"
  Environment = "poc"
  # KeepUntil = "2026-10-01"
}
