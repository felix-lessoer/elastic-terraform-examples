{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elastic.example/schemas/gcp/brownfield-manifest.v1.json",
  "title": "GCP brownfield discovery manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "approved_projects",
    "limits",
    "resources",
    "operation_results",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_projects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$"
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_api_calls",
        "max_resources",
        "max_concurrency",
        "per_call_timeout_seconds",
        "max_attempts"
      ],
      "properties": {
        "max_api_calls": { "type": "integer", "minimum": 1 },
        "max_resources": { "type": "integer", "minimum": 1 },
        "max_concurrency": { "type": "integer", "minimum": 1 },
        "per_call_timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_attempts": { "type": "integer", "minimum": 1 }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["project_id", "kind"],
        "properties": {
          "project_id": { "type": "string" },
          "kind": {
            "enum": [
              "asset",
              "logging_sink",
              "logging_bucket",
              "pubsub_topic",
              "pubsub_subscription",
              "alert_policy",
              "metrics_scope",
              "enabled_service"
            ]
          }
        }
      }
    },
    "operation_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "project_id",
          "operation",
          "status",
          "api_calls",
          "resources",
          "truncated"
        ],
        "properties": {
          "project_id": { "type": "string" },
          "operation": {
            "enum": [
              "asset.searchAllResources",
              "logging.sinks.list",
              "logging.buckets.list",
              "pubsub.topics.list",
              "pubsub.subscriptions.list",
              "monitoring.alertPolicies.list",
              "monitoring.metricsScopes.get",
              "serviceusage.services.list"
            ]
          },
          "status": { "type": "string" },
          "api_calls": { "type": "integer", "minimum": 0 },
          "resources": { "type": "integer", "minimum": 0 },
          "truncated": { "type": "boolean" },
          "error": { "type": "string" }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete",
        "projects",
        "operations",
        "api_calls",
        "resources",
        "resources_by_kind",
        "statuses"
      ],
      "properties": {
        "complete": { "type": "boolean" },
        "projects": { "type": "integer", "minimum": 1 },
        "operations": { "type": "integer", "minimum": 1 },
        "api_calls": { "type": "integer", "minimum": 0 },
        "resources": { "type": "integer", "minimum": 0 },
        "resources_by_kind": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "statuses": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
