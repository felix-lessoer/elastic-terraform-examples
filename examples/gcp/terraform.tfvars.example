deployment_mode      = "serverless"
elastic_project_name = "GCP Observe and Protect"
elastic_region       = "gcp-europe-west3"
google_cloud_project = "my-gcp-project"
google_cloud_region  = "europe-west3"
# google_cloud_credentials_file = "/path/to/sa.json"

# Required: company policy labels (applied to every labelable GCP resource)
company_labels = {
  cost-center = "platform"
  owner       = "sre-team"
  environment = "poc"
  # data-classification = "internal"
}

# Optional: fail plan if these keys are missing from company_labels
# required_label_keys = ["cost-center", "owner", "environment"]

enable_cspm            = true
enable_detection_rules = true
