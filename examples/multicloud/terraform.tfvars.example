deployment_mode = "serverless"
cps_hub         = "gcp"
product_tier    = "complete"

deploy_aws   = false
deploy_azure = false
deploy_gcp   = true

google_cloud_project = "my-gcp-project"
google_cloud_region  = "europe-west3"
elastic_gcp_region   = "gcp-europe-west3"

# Required: company policy tags/labels for every cloud resource
company_tags = {
  cost-center = "platform"
  owner       = "sre-team"
  environment = "poc"
}

# Optional hard requirement on keys
# required_tag_keys = ["cost-center", "owner", "environment"]
